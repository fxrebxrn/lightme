# ====================== Telegram ======================
# Bot token from @BotFather (old name API_TOKEN also works)
BOT_TOKEN=123456:ABC-DEF
# Admin Telegram IDs, comma separated (old name ADMIN_ID also works)
ADMIN_IDS=123456789
# Channel of the bot: used in "subscribe" button, support text and tech-work message
CHANNEL_USERNAME=@lightmetech
CHANNEL_URL=https://t.me/lightmetech
# Support contact and donate link (/support)
SUPPORT_USERNAME=@your_support
DONATE_URL=https://send.monobank.ua/jar/xxxx
# Bot link in the "Монітор світла" footer. Empty -> detected automatically
BOT_URL=
# Skip updates that came while the bot was offline
BOT_SKIP_UPDATES=true

# ====================== PostgreSQL ======================
# Either a full URL (Railway/Heroku style, postgres:// is fine) ...
DATABASE_URL=
# ... or separate parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lightme
POSTGRES_PASSWORD=lightme
POSTGRES_DB=lightme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Apply migrations automatically on start
DB_AUTO_MIGRATE=true

# ====================== Redis (optional) ======================
# FSM storage for several bot replicas. Empty -> memory
REDIS_URL=

# ====================== Business rules ======================
TIMEZONE=Europe/Kyiv
DEFAULT_LANGUAGE=uk
MAX_SUBSCRIPTIONS=5
MAX_COMPARES=5
REMINDER_MINUTES=10
FLAGS_CACHE_TTL=5

# ====================== Sending / logs ======================
SEND_RATE_PER_SECOND=25
SEND_MAX_RETRIES=3
LOG_LEVEL=INFO
